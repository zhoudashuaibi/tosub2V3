# 从而把 web/src/components/data/ 这类源码目录一起忽略掉
/data
data-backup-*
tmp
*.log
gui-test-screenshots
.env
.DS_Store
*.tsbuildinfo
.zcode
.agents
.playwright-mcp
example.json
# Python 运行时缓存：core/cloudflare-ctf 的动态 Sentinel / CF 求解器会生成
__pycache__/
*.pyc
